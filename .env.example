# Database — SQLite for local dev (change to PostgreSQL URL for production)
DATABASE_URL="file:./dev.db"

# NextAuth — generate a strong random secret for production
# Run: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic (Claude) API key — required for AI tutor
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Google OAuth (optional — leave empty to disable Google sign-in)
# Create credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
